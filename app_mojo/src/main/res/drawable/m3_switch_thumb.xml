<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="24dp" android:height="24dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/m3_on_primary" />
                </shape>
            </item>
            <item android:width="14dp" android:height="14dp" android:gravity="center"
                android:drawable="@drawable/ic_m3_check" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="24dp" android:height="24dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/m3_outline" />
                </shape>
            </item>
            <item android:width="12dp" android:height="12dp" android:gravity="center"
                android:drawable="@drawable/ic_m3_close" />
        </layer-list>
    </item>
</selector>
