<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="MojoLauncher" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/Mojo.PreferenceTheme</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:windowAnimationStyle">@style/M3ActivityAnim</item>
        <item name="alertDialogTheme">@style/M3AlertDialog</item>
        <item name="dialogCornerRadius">0dp</item>
        <item name="android:seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="android:switchStyle">@style/MojoLauncher.Switch</item>
        <item name="switchStyle">@style/MojoLauncher.Switch</item>
        <item name="buttonStyle">@style/MojoLauncher.Button</item>
        <item name="android:buttonStyleToggle">@style/MojoLauncher.Button.Toggle</item>
    </style>

    <style name="MojoLauncher.AppTheme" parent="MojoLauncher"/>

    <style name="MojoLauncher.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/minepb_progress</item>
        <item name="android:thumb">@drawable/mineknob_on_unfiltered</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
    </style>

    <style name="MojoLauncher.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/mineknob_track_mask_unfiltered</item>
        <item name="trackTint">@color/mineknob_track_tint</item>
        <item name="trackTintMode">multiply</item>
        <item name="android:thumb">@drawable/mineknob_switch</item>
        <item name="switchMinWidth">40dp</item>
    </style>

    <style name="MojoLauncher.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_flat</item>
    </style>

    <style name="MojoLauncher.Button.Toggle" parent="MojoLauncher.Button">
        <item name="android:background">@drawable/button_flat_toggle</item>
    </style>


    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="M3DialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/m3_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/m3_dialog_out</item>
    </style>

    <style name="M3AlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowAnimationStyle">@style/M3DialogAnim</item>
    </style>

    <style name="M3ActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/m3_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/m3_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/m3_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/m3_pop_exit</item>
    </style>

    <!-- Settings screen: card style preferences -->
    <style name="Mojo.PreferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceStyle">@style/Mojo.Pref</item>
        <item name="preferenceCategoryStyle">@style/Mojo.Pref.Category</item>
        <item name="switchPreferenceCompatStyle">@style/Mojo.Pref.Switch</item>
        <item name="dialogPreferenceStyle">@style/Mojo.Pref.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Mojo.Pref.EditText</item>
        <item name="seekBarPreferenceStyle">@style/Mojo.Pref.Seek</item>
    </style>

    <style name="Mojo.Pref" parent="Preference.Material">
        <item name="android:layout">@layout/pref_card</item>
        <item name="iconSpaceReserved">false</item>
        <item name="android:iconSpaceReserved">false</item>
    </style>

    <style name="Mojo.Pref.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/pref_card_category</item>
        <item name="iconSpaceReserved">false</item>
        <item name="android:iconSpaceReserved">false</item>
    </style>

    <style name="Mojo.Pref.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/pref_card</item>
        <item name="android:widgetLayout">@layout/pref_widget_switch_m3</item>
        <item name="iconSpaceReserved">false</item>
        <item name="android:iconSpaceReserved">false</item>
    </style>

    <style name="Mojo.Pref.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/pref_card</item>
        <item name="android:widgetLayout">@layout/pref_widget_dropdown</item>
        <item name="iconSpaceReserved">false</item>
        <item name="android:iconSpaceReserved">false</item>
    </style>

    <style name="Mojo.Pref.EditText" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/pref_card</item>
        <item name="iconSpaceReserved">false</item>
        <item name="android:iconSpaceReserved">false</item>
    </style>

    <style name="Mojo.Pref.Seek" parent="Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/pref_card_seekbar</item>
        <item name="iconSpaceReserved">false</item>
        <item name="android:iconSpaceReserved">false</item>
    </style>

    <style name="Mojo.SeekBar.M3" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/m3_seek_progress</item>
        <item name="android:thumb">@drawable/m3_seek_thumb</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:maxHeight">20dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="Mojo.RailItem" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/m3_rail_item</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
