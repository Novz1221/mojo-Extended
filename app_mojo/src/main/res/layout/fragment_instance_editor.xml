<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <include layout="@layout/layout_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:background="@drawable/m3_card">

                <ImageView
                    android:id="@+id/vprof_editor_instance_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/m3_card_ripple"
                    android:contentDescription="@string/m3_edit"
                    android:padding="12dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="34dp"
                    android:layout_marginTop="34dp"
                    android:background="@drawable/m3_button_primary"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_m3_paint"
                    android:tint="@color/m3_on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/vprof_editor_save_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/m3_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/global_save"
                android:textColor="@color/m3_on_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/vprof_editor_delete_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/m3_button_tonal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/global_delete"
                android:textColor="@color/m3_text"
                android:textSize="15sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/profiles_profile_name"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/m3_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <EditText
                        android:id="@+id/vprof_editor_instance_name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/unnamed"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/m3_text"
                        android:textColorHint="@color/m3_text_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <include
                    android:id="@+id/vprof_editor_version_row"
                    layout="@layout/item_gi_loader" />

                <include
                    android:id="@+id/vprof_editor_ctrl_row"
                    layout="@layout/item_gi_loader" />

                <LinearLayout
                    android:id="@+id/vprof_editor_data_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/m3_card_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_m3_folder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/m3_shared_data"
                            android:textColor="@color/m3_text"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/vprof_editor_data_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/m3_text_dim"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/vprof_editor_data_checkbox_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false"
                        android:thumb="@drawable/m3_switch_thumb"
                        app:showText="false"
                        app:switchMinWidth="56dp"
                        app:track="@drawable/m3_switch_track"
                        app:trackTint="@android:color/white"
                        app:trackTintMode="multiply" />
                </LinearLayout>

                <include
                    android:id="@+id/vprof_editor_runtime_row"
                    layout="@layout/item_gi_loader" />

                <include
                    android:id="@+id/vprof_editor_renderer_row"
                    layout="@layout/item_gi_loader" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/pvc_jvmArgs"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/m3_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <EditText
                        android:id="@+id/vprof_editor_jre_args"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/use_global_default"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/m3_text"
                        android:textColorHint="@color/m3_text_dim"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
