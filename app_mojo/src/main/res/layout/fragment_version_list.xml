<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <include layout="@layout/layout_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/vl_folder_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/m3_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/m3_default_game"
                        android:textColor="@color/m3_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/vl_folder_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/m3_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/vl_folder_more"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/m3_nav_off"
                    android:contentDescription="@string/m3_more"
                    android:src="@drawable/ic_m3_more"
                    android:tint="@color/m3_text" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/vl_add_folder"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/m3_button_primary"
                android:gravity="center"
                android:text="@string/m3_add_game_folder"
                android:textColor="@color/m3_on_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/vl_cleanup"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/m3_button_primary"
                android:gravity="center"
                android:text="@string/m3_cleanup"
                android:textColor="@color/m3_on_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/m3_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <LinearLayout
                        android:id="@+id/vl_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/m3_nav_off"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_m3_refresh"
                            android:tint="@color/m3_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/m3_refresh"
                            android:textColor="@color/m3_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/vl_install_new"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/m3_nav_off"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_m3_download"
                            android:tint="@color/m3_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/m3_install_new"
                            android:textColor="@color/m3_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/m3_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/vl_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/m3_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/vl_filter_vanilla"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/m3_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/vl_filter_moddable"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/m3_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/vl_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/vl_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/m3_pill"
                    android:paddingStart="22dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="12dp"
                    android:text="@string/m3_no_versions"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
