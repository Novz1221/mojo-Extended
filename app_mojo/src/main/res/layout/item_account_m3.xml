<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/m3_card_high"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <RadioButton
        android:id="@+id/acc_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/m3_primary"
        android:clickable="false"
        android:focusable="false" />

    <ImageView
        android:id="@+id/acc_head"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/acc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/m3_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/acc_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/m3_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/acc_refresh"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/m3_nav_off"
        android:contentDescription="@string/m3_refresh"
        android:src="@drawable/ic_m3_refresh"
        android:tint="@color/m3_text_dim" />

    <ImageButton
        android:id="@+id/acc_more"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/m3_nav_off"
        android:contentDescription="@string/m3_more"
        android:src="@drawable/ic_m3_more"
        android:tint="@color/m3_text" />
</LinearLayout>
