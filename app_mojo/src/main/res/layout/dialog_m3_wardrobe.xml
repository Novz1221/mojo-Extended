<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/m3_dialog"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wd_preview"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/m3_card_high"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/wd_change"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/m3_card_high"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/m3_change_skin"
                    android:textColor="@color/m3_text"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_m3_upload"
                    android:tint="@color/m3_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wd_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/m3_button_tonal"
            android:gravity="center"
            android:text="@android:string/cancel"
            android:textColor="@color/m3_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/wd_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/m3_button_primary"
            android:gravity="center"
            android:text="@string/m3_confirm"
            android:textColor="@color/m3_on_primary"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
