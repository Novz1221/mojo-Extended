<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/settings_tab_video"
                style="@style/Mojo.RailItem"
                android:contentDescription="@string/preference_video_title"
                android:src="@drawable/ic_px_image" />

            <ImageButton
                android:id="@+id/settings_tab_control"
                style="@style/Mojo.RailItem"
                android:contentDescription="@string/preference_control_title"
                android:src="@drawable/ic_px_gamepad" />

            <ImageButton
                android:id="@+id/settings_tab_java"
                style="@style/Mojo.RailItem"
                android:contentDescription="@string/preference_java_title"
                android:src="@drawable/ic_px_java" />

            <ImageButton
                android:id="@+id/settings_tab_misc"
                style="@style/Mojo.RailItem"
                android:contentDescription="@string/preference_misc_title"
                android:src="@drawable/ic_px_alt_sliders" />

            <ImageButton
                android:id="@+id/settings_tab_experimental"
                style="@style/Mojo.RailItem"
                android:contentDescription="@string/preference_experimental_title"
                android:src="@drawable/ic_px_experiment" />

            <ImageButton
                android:id="@+id/settings_tab_general"
                style="@style/Mojo.RailItem"
                android:contentDescription="@string/settings_tab_general"
                android:src="@drawable/ic_m3_settings"
                android:tint="@color/m3_text" />
        </LinearLayout>
    </ScrollView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settings_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
