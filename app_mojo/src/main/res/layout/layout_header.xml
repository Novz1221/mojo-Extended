<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/header_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/m3_nav_off"
        android:contentDescription="@string/m3_back"
        android:src="@drawable/ic_m3_back"
        android:tint="@color/m3_text_dim" />

    <ImageButton
        android:id="@+id/header_home"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/m3_nav_off"
        android:contentDescription="@string/m3_home"
        android:src="@drawable/ic_m3_home"
        android:tint="@color/m3_text_dim" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/m3_text"
        android:textSize="20sp" />
</LinearLayout>
