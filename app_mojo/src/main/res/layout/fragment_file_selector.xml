<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <include layout="@layout/layout_header" />

    <com.kdt.pickafile.FileListView
        android:id="@+id/file_selector"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/file_selector_create_folder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/m3_button_tonal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/folder_fragment_create"
            android:textColor="@color/m3_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/file_selector_select_folder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/m3_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/folder_fragment_select"
            android:textColor="@color/m3_on_primary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
