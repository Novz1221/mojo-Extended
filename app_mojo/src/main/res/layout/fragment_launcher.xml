<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_pill"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="@string/m3_menu"
            android:textColor="@color/m3_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_menu_panel"
            android:orientation="vertical"
            android:padding="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tile_settings"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/m3_tile"
                    android:contentDescription="@string/m3_settings"
                    android:padding="24dp"
                    android:src="@drawable/ic_m3_settings"
                    android:tint="@color/m3_text_dim" />

                <ImageView
                    android:id="@+id/tile_download"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/m3_tile"
                    android:contentDescription="@string/m3_download"
                    android:padding="24dp"
                    android:src="@drawable/ic_m3_download"
                    android:tint="@color/m3_text_dim" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tile_versions"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/m3_tile"
                    android:contentDescription="@string/m3_versions"
                    android:padding="24dp"
                    android:src="@drawable/ic_m3_folder"
                    android:tint="@color/m3_text_dim" />

                <ImageView
                    android:id="@+id/tile_controls"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/m3_tile"
                    android:contentDescription="@string/m3_controls"
                    android:padding="22dp"
                    android:src="@drawable/ic_px_gamepad" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/home_share_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/m3_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="@string/m3_share_log"
            android:textColor="@color/m3_on_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="206dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_pill"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="@string/m3_home_title"
            android:textColor="@color/m3_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/m3_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/home_account_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/m3_card_ripple"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/home_account_head"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/home_add_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_m3_plus"
                    android:tint="@color/m3_text" />

                <TextView
                    android:id="@+id/home_account_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxWidth="150dp"
                    android:singleLine="true"
                    android:text="@string/m3_add_account"
                    android:textColor="@color/m3_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/home_account_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_version_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/m3_card_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/home_version_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_grass_block" />

                <TextView
                    android:id="@+id/home_version_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/m3_no_versions"
                    android:textColor="@color/m3_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/m3_button_primary"
                android:gravity="center"
                android:text="@string/m3_launch"
                android:textColor="@color/m3_on_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
