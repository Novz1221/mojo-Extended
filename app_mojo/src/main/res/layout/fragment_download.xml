<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <include layout="@layout/layout_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/nav_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/nav_game_pill"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/m3_nav_off">

                    <ImageView
                        android:id="@+id/nav_game_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_game"
                        android:tint="@color/m3_text_dim" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/m3_nav_game"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_modpack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/nav_modpack_pill"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/m3_nav_off">

                    <ImageView
                        android:id="@+id/nav_modpack_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_pack"
                        android:tint="@color/m3_text_dim" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/m3_nav_modpack"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/m3_surface_high" />

            <LinearLayout
                android:id="@+id/nav_mod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/nav_mod_pill"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/m3_nav_off">

                    <ImageView
                        android:id="@+id/nav_mod_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_mod"
                        android:tint="@color/m3_text_dim" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/m3_nav_mod"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_resource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/nav_resource_pill"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/m3_nav_off">

                    <ImageView
                        android:id="@+id/nav_resource_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_paint"
                        android:tint="@color/m3_text_dim" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/m3_nav_resource"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_saves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/nav_saves_pill"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/m3_nav_off">

                    <ImageView
                        android:id="@+id/nav_saves_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_globe"
                        android:tint="@color/m3_text_dim" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/m3_nav_saves"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_shader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/nav_shader_pill"
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/m3_nav_off">

                    <ImageView
                        android:id="@+id/nav_shader_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_bulb"
                        android:tint="@color/m3_text_dim" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="@string/m3_nav_shader"
                    android:textColor="@color/m3_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/panel_game"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_release"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/m3_chip_release"
                        android:textColor="@color/m3_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/chip_snapshot"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/m3_chip_snapshot"
                        android:textColor="@color/m3_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/chip_april"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/m3_chip_april"
                        android:textColor="@color/m3_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/chip_old"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/m3_chip_old"
                        android:textColor="@color/m3_text"
                        android:textSize="14sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <EditText
                        android:id="@+id/dl_game_search"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/m3_pill"
                        android:hint="@string/m3_search"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/m3_text"
                        android:textColorHint="@color/m3_text_dim"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/dl_game_refresh"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/m3_nav_off"
                        android:contentDescription="@string/m3_refresh"
                        android:src="@drawable/ic_m3_refresh"
                        android:tint="@color/m3_text" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/m3_surface_high" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dl_game_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/dl_game_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/m3_pill"
                        android:paddingStart="20dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="10dp"
                        android:text="@string/m3_loading"
                        android:textColor="@color/m3_text_dim"
                        android:textSize="15sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/m3_pill"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dl_page_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/m3_page_empty"
                            android:textColor="@color/m3_text"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/dl_page_prev"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="30dp"
                            android:background="@drawable/m3_nav_off"
                            android:contentDescription="@string/m3_prev"
                            android:src="@drawable/ic_m3_prev"
                            android:tint="@color/m3_text_dim" />

                        <ImageButton
                            android:id="@+id/dl_page_next"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:background="@drawable/m3_nav_off"
                            android:contentDescription="@string/m3_next"
                            android:src="@drawable/ic_m3_next"
                            android:tint="@color/m3_text" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/dl_content_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/dl_content_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/m3_pill"
                            android:gravity="center"
                            android:maxWidth="320dp"
                            android:paddingStart="20dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="10dp"
                            android:text="@string/m3_loading"
                            android:textColor="@color/m3_text_dim"
                            android:textSize="15sp" />
                    </FrameLayout>
                </LinearLayout>

                <ScrollView
                    android:layout_width="168dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/m3_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/dl_filter_name"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/m3_search_name"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/m3_text"
                        android:textColorHint="@color/m3_text_dim"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/dl_filter_name_btn"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/m3_nav_off"
                        android:contentDescription="@string/m3_search_name"
                        android:src="@drawable/ic_m3_search"
                        android:tint="@color/m3_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/m3_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/dl_filter_version"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/m3_game_version"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/m3_text"
                        android:textColorHint="@color/m3_text_dim"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/dl_filter_version_btn"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/m3_nav_off"
                        android:contentDescription="@string/m3_game_version"
                        android:src="@drawable/ic_m3_search"
                        android:tint="@color/m3_text" />
                </LinearLayout>

                        <TextView
                            android:id="@+id/dl_import_modpack"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/m3_card_ripple"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/m3_import_modpack"
                            android:textColor="@color/m3_text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/dl_platform_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/m3_card_ripple"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/m3_target_platform"
                                    android:textColor="@color/m3_text"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/dl_platform_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/m3_badge_green"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:textColor="@color/m3_on_green"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_m3_dropdown"
                                android:tint="@color/m3_text" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/dl_sort_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/m3_card_ripple"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/m3_sort_by"
                                    android:textColor="@color/m3_text"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/dl_sort_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/m3_badge_pink"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:textColor="@color/m3_on_badge"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_m3_dropdown"
                                android:tint="@color/m3_text" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
