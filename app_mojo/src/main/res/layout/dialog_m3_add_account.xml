<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/m3_dialog"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/add_microsoft"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/m3_card_high"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/m3_microsoft"
                android:textColor="@color/m3_text"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_m3_login"
                android:tint="@color/m3_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/add_auth"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/m3_card_high"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/m3_add_auth"
                android:textColor="@color/m3_text"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_m3_next"
                android:tint="@color/m3_text" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/add_offline"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/m3_card_high"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/m3_offline"
                android:textColor="@color/m3_text"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_m3_login"
                android:tint="@color/m3_text" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_margin="4dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/add_close"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_margin="4dp"
        android:background="@drawable/m3_button_primary"
        android:gravity="center"
        android:text="@string/m3_close"
        android:textColor="@color/m3_on_primary"
        android:textSize="16sp" />
</LinearLayout>
