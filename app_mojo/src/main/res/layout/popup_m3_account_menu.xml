<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/m3_dialog"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/pm_wardrobe"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/m3_nav_off"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_m3_hanger"
            android:tint="@color/m3_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/m3_wardrobe"
            android:textColor="@color/m3_text"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pm_copy"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/m3_nav_off"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_m3_copy"
            android:tint="@color/m3_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/m3_copy_uuid"
            android:textColor="@color/m3_text"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pm_delete"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/m3_nav_off"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_m3_delete"
            android:tint="@color/m3_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/global_delete"
            android:textColor="@color/m3_text"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
