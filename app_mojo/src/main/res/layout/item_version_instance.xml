<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vi_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/m3_card_ripple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/vi_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vi_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/m3_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/vi_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/m3_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/vi_selected"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_m3_check"
        android:tint="@color/m3_primary" />

    <ImageButton
        android:id="@+id/vi_edit"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/m3_nav_off"
        android:contentDescription="@string/m3_edit"
        android:src="@drawable/ic_px_edit"
        android:tint="@color/m3_text" />

    <ImageButton
        android:id="@+id/vi_delete"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/m3_nav_off"
        android:contentDescription="@string/global_delete"
        android:src="@drawable/ic_m3_delete"
        android:tint="@color/m3_text" />
</LinearLayout>
