{
  "rules": {
    "users": {
      "$u": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['n','s'])",
        "n": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16" },
        "s": { ".validate": "newData.isString() && newData.val().length == 64" }
      }
    },
    "rooms": {
      ".read": true,
      "$r": {
        ".write": true,
        ".validate": "$r.length <= 20 && newData.val() == true"
      }
    },
    "messages": {
      "$r": {
        ".read": true,
        "$m": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['u','t','ts']) && newData.child('t').isString() && newData.child('t').val().length <= 300 && newData.child('u').isString() && newData.child('u').val().length <= 16 && newData.child('ts').val() == now"
        }
      }
    },
    "friends": { "$u": { ".read": true, ".write": true } },
    "voice": { ".read": true, "$r": { ".write": true } }
  }
}
